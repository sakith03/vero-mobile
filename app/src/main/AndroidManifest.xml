<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".VeroMobile"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VeroMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VeroMobile"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- TEMPORARY: Debug-only Activity for testing Firebase Auth registration.
             Launch via ADB:  adb shell am start -n com.example.veromobile/.ui.debug.FirebaseAuthTestActivity
             Remove this entry after testing. -->
        <activity
            android:name=".ui.debug.FirebaseAuthTestActivity"
            android:exported="true"
            android:label="Firebase Auth Test"
            android:theme="@style/Theme.VeroMobile" />
    </application>

</manifest>